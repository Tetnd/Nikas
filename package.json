{
  "name": "nika",
  "displayName": "Nika",
  "description": "DeepSeek language model provider for VS Code Copilot Chat, with configurable vision preprocessing (Gemma 4 via Ollama or Gemini)",
  "version": "0.3.5",
  "publisher": "nika",
  "icon": "logo.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alive2/nika.git"
  },
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Chat",
    "Machine Learning"
  ],
  "activationEvents": [
    "onLanguageModelChatProvider:nika"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "nika",
        "displayName": "Nika",
        "managementCommand": "nika.manage"
      }
    ],
    "commands": [
      {
        "command": "nika.chooseProvider",
        "title": "Choose Provider",
        "category": "Nika"
      },
      {
        "command": "nika.chooseVisionModel",
        "title": "Choose Vision Model",
        "category": "Nika"
      },
      {
        "command": "nika.setOllamaHost",
        "title": "Set Ollama Host",
        "category": "Nika"
      },
      {
        "command": "nika.inputDeepseekToken",
        "title": "Input DeepSeek API Key",
        "category": "Nika"
      },
      {
        "command": "nika.chooseThinkingEffort",
        "title": "Thinking Effort",
        "category": "Nika"
      },
      {
        "command": "nika.agentModelOverrides",
        "title": "Agent Model Overrides",
        "category": "Nika"
      },
      {
        "command": "nika.manage",
        "title": "Manage Nika Models",
        "category": "Nika",
        "icon": "$(settings-gear)"
      },
      {
        "command": "nika.checkForUpdates",
        "title": "Check for Updates",
        "category": "Nika",
        "icon": "$(cloud-download)"
      }
    ],
    "configuration": {
      "title": "Nika",
      "properties": {
        "nika.selectedModel": {
          "type": "string",
          "default": "deepseek-v4-flash",
          "enum": [
            "deepseek-v4-flash",
            "deepseek-v4-pro"
          ],
          "description": "The DeepSeek model to use for chat"
        },
        "nika.maxTokens": {
          "type": "number",
          "default": 8192,
          "minimum": 1,
          "maximum": 8192,
          "description": "Maximum output tokens per response"
        },
        "nika.temperature": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 2,
          "description": "Temperature for response generation"
        },
        "nika.thinkingEffort": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "low",
            "medium",
            "high"
          ],
          "enumDescriptions": [
            "No thinking mode — fastest responses",
            "Light thinking (1K token budget)",
            "Moderate thinking (4K token budget)",
            "Deep thinking (8K token budget)"
          ],
          "description": "Thinking/reasoning effort level. Only applicable when using a model that supports thinking (e.g., DeepSeek V4 Pro). Higher effort produces more thorough reasoning but slower responses."
        },
        "nika.visionModel": {
          "type": "string",
          "default": "ollama-gemma4",
          "enum": [
            "ollama-gemma4",
            "gemini"
          ],
          "description": "Vision model for image preprocessing. Gemma 4 runs locally via Ollama (no API key needed). Gemini uses Google AI Studio (free tier, needs API key)."
        },
        "nika.ollamaBaseUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama server URL. Points to localhost by default, but can be any remote Ollama instance (e.g., http://192.168.1.100:11434). Used when vision model is Gemma 4."
        },
        "nika.agentModelOverrides": {
          "type": "object",
          "default": {},
          "description": "Per-agent model and thinking overrides. Map agent names (e.g., 'explore', 'edit', 'chat') to { \"model\": \"...\", \"thinkingEffort\": \"...\" }. Use 'Nika: Agent Model Overrides' from the command palette to configure interactively."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.109.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.5.0"
  }
}
